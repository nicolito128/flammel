{
  "name": "flammel-bot",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file .env  dist/index.js",
    "build": "npm run clean && tsc --project tsconfig.json",
    "clean": "rimraf -I dist",
    "fmt": "ts-standard --fix && standard --fix"
  },
  "author": "Nicolas A. Serna",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "seyfert": "2.2.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "standard": "^17.1.0",
    "ts-standard": "^12.0.2",
    "typescript": "^5.5.4"
  },
  "ts-standard": {
    "project": "./tsconfig.json",
    "ignore": [
      "dist",
      "src/**/*.js"
    ]
  }
}
